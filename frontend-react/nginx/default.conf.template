# Patron 5 (Reverse Proxy): Nginx sirve React y reenvia /api/* al API Gateway.
# La imagen oficial de nginx sustituye ${API_UPSTREAM} al arrancar (envsubst sobre /etc/nginx/templates).
# Solo se reemplazan variables de entorno definidas, asi que $uri, $host, etc. quedan intactas.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA: cualquier ruta desconocida devuelve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};             # p.ej. https://abc123.execute-api.us-east-1.amazonaws.com
        proxy_http_version 1.1;
        proxy_ssl_server_name on;               # SNI requerido por API Gateway
        proxy_set_header Host $proxy_host;      # API Gateway enruta por Host
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;                 # > peor caso de la cadena de resiliencia (~7 s)
    }

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }
}
